---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import { Heading, Link } from 'accessible-astro-components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Find us </Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="https://www.linkedin.com/company/the-aster-app/">LinkedIn</Link></li>
          <li><Link href="https://www.instagram.com/aster.bees">Instagram</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">More information</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/accessibility-statement">Accessibility statement</Link></li>
          <li><Link href="/sitemap">Sitemap</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Newsletter sign up</Heading>
        <div style="min-height: 58px;max-width: 440px;margin: 0 auto;width: 100%">
          <script
            src="https://cdn.jsdelivr.net/ghost/signup-form@~0.3/umd/signup-form.min.js"
            data-button-color="#bb78ff"
            data-button-text-color="#FFFFFF"
            data-site="https://blog.asterbees.org/"
            data-locale="en"
            async></script>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" />
        <p class="leading-[1.75]">
          Aster is a beekeeping app that helps beekeepers beekeep better. We are currently funded by the EXIST grant
          from the German government until April 2026. We want to build an app that has direct ideas and feedback from
          beekeepers on the ground. So, please, get in touch!
        </p>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - Aster & <Link href="https://pandionlabs.dev/">Pandion Labs</Link>.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
