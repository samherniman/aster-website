---
import { Heading } from 'accessible-astro-components'

interface Props {
  title: string
}

const { title }: Props = Astro.props
---

<div class="flex flex-row items-center justify-between m-6">
  <hr class="flex-1 text-neutral-500" />
  <Heading level="h2" size="h5" class="px-7 text-(--link-color) font-bold">{title}</Heading>
  <hr class="flex-1 text-neutral-500" />
</div>
