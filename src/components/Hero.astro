---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import hiw from '@assets/images/howitworks.png'

interface IconDetail {
  /** The name of the icon (e.g., from an icon pack recognized by astro-icon). */
  name: string
  /** The link to navigate to when the icon is clicked. */
  link: string
  /** The width of the icon. Can be a string (e.g., "24px") or a number (e.g., 24). */
  width?: string | number
  /** The height of the icon. Can be a string (e.g., "24px") or a number (e.g., 24). */
  height?: string | number
  /** Optional CSS class to apply to the icon's container div for specific styling. */
  class?: string
}

const iconBigSize = {
  width: 150,
  height: 150,
}

const iconSmallSize = {
  width: 150,
  height: 150,
}

interface Props {
  /**
   * Whether to load the image eagerly or lazily
   * @default 'eager'
   */
  loading?: 'eager' | 'lazy'
}

const { loading = 'eager' }: Props = Astro.props
const icons: IconDetail[] = [
  // This will be rendered in a 2x2 grid
  // First Row
  { name: 'lucide:bar-chart', link: '/science', ...iconSmallSize, class: 'icon-wrapper icon-secondary order-1' },
  { name: 'lucide:flower-2', link: '/biodiversity', ...iconBigSize, class: 'icon-wrapper icon-primary order-2' },
  // Second Row
  { name: 'lucide:trees', link: 'forest', ...iconBigSize, class: 'icon-wrapper icon-primary order-4 lg:order-3' },
  {
    name: 'lucide:workflow',
    link: 'custom-solutions',
    ...iconSmallSize,
    class: 'icon-wrapper icon-secondary order-3 lg:order-3',
  },
]
---

<section class="hero my-10 mb-25">
  <div class="container">
    <div class="flex flex-row items-end gap-3">
      <div class="grid grid-cols-1 items-end gap-24 lg:grid-cols-2">
        <div class="flex flex-col items-left gap-8 md:items-start">
          <h1 class="justify-start text-left text-6xl font-bold md:text-left lg:text-7xl">
            <span class="text-black">Every bee counts.</span>
          </h1>
          <p class="text-left text-xl md:text-left">
            Aster is a beekeeping app that helps beekeepers beekeep better.
          </p>
          <div class="flex flex-row gap-3 min-[500px]:flex-row">
            <a class="button color-dark" href="#services">
              Join the Aster community
            </a>
            <a class="button" href="#contact">
              Contact us
            </a>
          </div>
        </div>
        </div>
      <div>
      <a href="/" class="flex items-right gap-10 !no-underline">
         <Image src={hiw} alt="Image showing a beekeeper using a whole by a beehive" width="600" loading={loading} />
      </a>
      </div>
    </div>


    <style lang="scss">
      h1 {
        text-wrap: unset;
      }

      a {
        color: inherit;
      }

      .icon-wrapper {
        place-self: center;
        box-shadow: var(--elevation-3, 0 1px 3px rgba(0 0 0 / 0.12));
        border-radius: var(--radius-l, 0.75rem);
        padding: 1.25rem;
      }

      .icon-primary {
        color: var(--color-primary-200);
      }
      .icon-secondary {
        /* use default font color */
      }
      .icon-wrapper:hover {
        transform: scale(1.08);
      }
      [data-icon] {
        opacity: 0.75;
      }
    </style>
  </div>
</section>
