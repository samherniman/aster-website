---
import { Card, Heading, Link } from 'accessible-astro-components'
// import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

/**
 * Team Component
 *
 * @description A component that displays a team
 */
interface Props {
  /**
   * The name of the person to display
   */
  title: string
  /**
   * The heading level for the team title
   * @default 'h3'
   */
  level?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  /**
   * The image to display
   */
  profileImage: any
  /**
   * The experience string
   */
  experience: string
  /**
   * The education string
   */
  education: string
}

const { loading = 'eager' }: Props = Astro.props
const { title = 'Title', level = 'h3', profileImage, experience = 'test', education = 'Test' }: Props = Astro.props
---

<div class="team flex flex-col gap-4">
  <div class="content">
    <Heading level={level} size="h6" class="mb-2">{title}</Heading>
    <p>
      {education}
    </p>
    <Image src={profileImage} alt={title} aria-hidden="true" layout="full-width" position="center" loading={loading} />
    <p>
      {experience}
    </p>
  </div>
</div>

<style lang="scss">
  @use 'scss/base/breakpoint' as *;

  .team {
    position: relative;
    padding: var(--space-l);
    inline-size: calc(100% - var(--space-l));

    > * {
      position: relative;
      z-index: 2;
    }

    @include breakpoint(xl) {
      inline-size: 100%;
    }

    &::before,
    &::after {
      position: absolute;
      content: '';
    }

    &::before {
      z-index: 1;
      inset: 0;
      box-shadow: 0 0 0 6px var(--color-neutral-100);
      border: 3px solid var(--color-neutral-700);
      border-radius: var(--radius-l);
      background-color: var(--color-neutral-100);
    }

    &::after {
      z-index: 0;
      inset: var(--space-m) -0.85rem -0.85rem 1rem;
      border-radius: var(--radius-l);
      // background-color: var(--link-color);
    }
  }

  :global(.team [data-icon]) {
    inline-size: 4rem;
    block-size: auto;
    color: var(--link-color);
  }

  :global(.darkmode .team::before) {
    box-shadow: 0 0 0 6px var(--color-neutral-900);
    background-color: var(--color-neutral-900);
  }
</style>
