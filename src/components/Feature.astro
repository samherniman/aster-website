---
import { Card, Heading, Link } from 'accessible-astro-components'
// import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

/**
 * Feature Component
 *
 * @description A component that displays a feature with an icon, title, and description
 */
interface Props {
  /**
   * The title to display
   */
  title: string
  /**
   * The number to display
   */
  number: number
  /**
   * The text to display
   */
  text: string
  /**
   * The heading level for the feature title
   * @default 'h3'
   */
  level?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  imageloc: any
  /**
   * The image to display
   */
}

const {
  title = 'Title',
  number = 1,
  text = 'alhwoehaof',
  level = 'h3',
  imageloc,
}: Props = Astro.props
---

<div class="feature content flex flex-col gap-1 rounded-xl bg-neutral-200 p-3 dark:bg-neutral-900">
  <!-- <Icon aria-hidden="true" name={icon} /> -->
  <div class="flex flex-shrink flex-row gap-3 md:flex-wrap justify-start items-center">
    <div class="numberCircle">
      <span class="text-neutral-100 text-2xl text-bold">{number}</span>
    </div>
    <Heading level={level} size="h4" class="mb-2 text-center">{title}</Heading>
  </div>
  <div>
    <Image src={imageloc} alt="Aster logo" aria-hidden="true" loading="lazy" class="shrink" />
    <p class="text-center">{text}</p>
  </div>
</div>

<style lang="scss">

h4 {
  font-weight: bold;
  font-size: var(--font-size-2);
}
  /*
Source - https://stackoverflow.com/a/19613616
Posted by Mike, modified by community. See post 'Timeline' for change history
Retrieved 2026-08-24, License - CC BY-SA 4.0
*/

  .numberCircle {
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background-color: var(--brand-primary);
    aspect-ratio: 1 / 1;
    width: 3rem; /* Set this to slightly wider than the longest string */
  }
</style>
