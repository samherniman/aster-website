---
import { Heading, Link } from 'accessible-astro-components'
// import { Icon } from 'astro-icon/components'

/**
 * CallToAction Component
 *
 * @description A prominent call-to-action section with a title and link
 */
interface Props {
  /**
   * The title text to display
   * @default "Get this theme on GitHub"
   */
  title?: string
  /**
   * The call to action text
   * @default "bla bla bla"
   */
  copytext?: string
  /**
   * The URL the button should link to
   * @default "https://github.com/incluud/accessible-astro-starter"
   */
  link?: string
  /**
   * The text to display on the button
   * @default "Get Started"
   */
  linkText?: string
}

const {
  title = "Beekeeping events, all in one place",
  copytext = "Welcome to the Aster event ticker! We're tracking all beekeeping events in one space (on Google Drive). This is our way of building community, as well as letting those interested know where we're headed and when!",
  link = 'https://blog.asterbees.org',
  linkText = 'This will be added later',
} = Astro.props

const [first, ...rest] = title.split(' ')

---

  <div class="call-to-action flex flex-col gap-1 rounded-xl bg-neutral-200 p-4 dark:bg-neutral-900">
    <Heading level="h4" size="h4" class="mb-2 text-left">{first}<br />{rest.join(' ')}</Heading>
    <p class="text-left text-1xl md:text-left">
      {copytext}
    </p>
    
    <Link href={link} isButton size="lg" animateOnHover animationType="nudge">
      {linkText}
      <!-- <Icon aria-hidden="true" name="lucide:rocket" size="1.5rem" /> -->
    </Link>
    <!-- <p class="text-left text-2xl md:text-left">
      Or subscribe to get our email newsletter sent directly to your inbox
    </p> -->
    <!-- <div style="min-height: 58px;max-width: 280px;margin: 0 auto;width: 80%"><script src="https://cdn.jsdelivr.net/ghost/signup-form@~0.3/umd/signup-form.min.js" data-button-color="#bb78ff" data-button-text-color="#FFFFFF" data-site="https://blog.asterbees.org/" data-locale="en" async></script></div> -->

  </div>

<style lang="scss">
  @use 'scss/base/mixins' as *;

  h4 {
  font-weight: bold;
  font-size: var(--font-size-2);
}

  .call-to-action {
    // position: relative;
    // margin-bottom: auto
    // background-image: linear-gradient(
    //   315deg,
    //   light-dark(var(--color-primary-100), var(--color-secondary-100)) 25%,
    //   light-dark(var(--color-secondary-100), var(--color-primary-200))
    // );
    // color: var(--color-neutral-900);
  }
</style>
