---
import { Card, Heading, Link } from 'accessible-astro-components'
// import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

/**
 * Feature2 Component
 *
 * @description A component that displays a feature2 with an icon, title, and description
 */
interface Props {
  /**
   * The icon to display
   */
  icon: string
  /**
   * The title to display
   */
  title: string
  /**
   * The number to display
   */
  number: string
  /**
   * The heading level for the feature2 title
   * @default 'h3'
   */
  level?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
  imageloc: any
  /**
   * The image to display
   */
}

const { loading = 'eager' }: Props = Astro.props
const { icon = 'mdi:rocket', title = 'Title', number = '1', level = 'h3', imageloc }: Props = Astro.props
---

<div class="feature2 flex flex-col gap-4">
  <!-- <Icon aria-hidden="true" name={icon} /> -->
  <div class="content">
    <Heading level={level} size="h4" class="mb-2">{title}</Heading>
    <div class="flex flex-row gap-3 items-center flex-shrink md:flex-wrap">
    <Image
        src={imageloc}
        alt="Aster logo"
        aria-hidden="true"
        position='center'
        loading={loading}
      />
    <p>
      <slot>Lorem ipsum dolor sit amet consectetur adipisicing elit. Hic, corporis.</slot>
    </p>
     </div>
    
  </div>
</div>

<style lang="scss">
  @use 'scss/base/breakpoint' as *;

  .feature2 {
    position: relative;
    padding: var(--space-l);
    inline-size: calc(100% - var(--space-l));

    > * {
      position: relative;
      z-index: 2;
    }

    @include breakpoint(xl) {
      inline-size: 100%;
    }

    &::before,
    &::after {
      position: absolute;
      content: '';
    }

    &::before {
      z-index: 1;
      inset: 0;
      box-shadow: 0 0 0 6px var(--color-neutral-100);
      // border: 3px solid var(--color-neutral-700);
      border-radius: var(--radius-l);
      background-color: var(--color-box-300);
    }

    &::after {
      z-index: 0;
      inset: var(--space-m) -0.85rem -0.85rem 1rem;
      border-radius: var(--radius-l);
      // background-color: var(--link-color);
    }
  }

  :global(.feature2 [data-icon]) {
    inline-size: 4rem;
    block-size: auto;
    color: var(--link-color);
  }

  :global(.darkmode .feature2::before) {
    box-shadow: 0 0 0 6px var(--color-neutral-900);
    background-color: var(--color-neutral-900);
  }

/*
Source - https://stackoverflow.com/a/19613616
Posted by Mike, modified by community. See post 'Timeline' for change history
Retrieved 2026-08-24, License - CC BY-SA 4.0
*/

.numberCircle {
  display: flex;
  width: 4ch; /* Set this to slightly wider than the longest string */
  align-items: center;  
  justify-content: center;
  aspect-ratio: 1 / 1;
  border-radius: 50%;  
  border: 2px solid #ad64f7;
  background-color: #ad64f7;
}

</style>
