---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Form, Input, Button, Textarea, Heading, Link } from 'accessible-astro-components'
import Image from 'astro/components/Image.astro'

import Leo from '@assets/images/team/leo.jpg'

const { loading = 'eager' }: Props = Astro.props
---

<DefaultLayout title="Contact">
  <PageHeader title="Leopold Dodd" subtitle="Head of beekeeping & field operations" bgType="gradient" />
  <section class="container my-16">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
      <div class="space-content">
        <Image
          src={Leo}
          alt="Leopold Dodd"
          aria-hidden="true"
          layout="full-width"
          position="center"
          loading={loading}
        />
      </div>
      <div class="space-content">
        <Heading level="h2">Contact details</Heading>
        <p>
          A certified beekeeper with 10 years of practical experience, Leopold provides beekeeping expertise and
          knowledge to inform the development of the app, leads app testing, and fosters Aster's beekeeper community. A
          native German speaker, he is the contact point for German relations.
        </p>
        <div class="gap-2xs flex flex-wrap items-center">
          <!-- <Icon aria-hidden="true" name="lucide:mail" size={20} class="shrink-0" /> -->
          <Link
            href="https://www.linkedin.com/in/maximilian-leopold-winkler-a5594b296/"
            isButton
            type="secondary"
            animateOnHover
            animationType="boop">LinkedIn</Link
          >
        </div>
        <div class="gap-2xs flex items-center">
          <!-- <Icon aria-hidden="true" name="lucide:clock" size={20} class="shrink-0" /> -->
          <!-- <p>
            <span class="font-bold">Availability:</span>
            Monday to Thursday, 9:00 to 17:00
          </p> -->
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>
