---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Form, Input, Button, Textarea, Heading, Link } from 'accessible-astro-components'
import Image from 'astro/components/Image.astro'

import Anna from '@assets/images/team/anna.jpg'

const { loading = 'eager' }: Props = Astro.props


---

<DefaultLayout title="Contact">
  <PageHeader
    title="Anna Dodd"
    subtitle="Cheif executive officer"
    bgType="gradient"
  />
  <section class="container my-16">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
      <div class="space-content">
         <Image
        src={Anna}
        alt="Anna Dodd"
        aria-hidden="true"
        layout='full-width'
        position='center'
        loading={loading}
      />
        
      </div>
      <div class="space-content">
        <Heading level="h2">Contact details</Heading>
        <p>Anna has worked across the fields of economic development, journalism, communications, and politics. For Aster, she brings her diverse experience to lead the company's communications, partnerships, and financials. She is also a beekeeping apprentice.</p>
     <div class="gap-2xs flex items-center flex-wrap">
          <!-- <Icon aria-hidden="true" name="lucide:mail" size={20} class="shrink-0" /> -->
            <Link 
            href="https://www.linkedin.com/in/anna-dodd/"
            isButton
            type="secondary"
            animateOnHover
            animationType="boop"
            >LinkedIn</Link>
        </div>
        <div class="gap-2xs flex items-center">
          <!-- <Icon aria-hidden="true" name="lucide:clock" size={20} class="shrink-0" /> -->
          <!-- <p>
            <span class="font-bold">Availability:</span>
            Monday to Thursday, 9:00 to 17:00
          </p> -->
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>
