---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Team from '@components/Team.astro'
import CallToAction from '@components/CallToAction.astro'
import Image from 'astro/components/Image.astro'
import Supporterlogo from '@components/Supporterlogo.astro'





import featureImage from "@assets/images/features/howitworkscards.png";
import featureImage1 from '@assets/images/features/howitworkscards1.png';
import featureImage2 from '@assets/images/features/howitworkscards2.png';
import featureImage3 from '@assets/images/features/howitworkscards3.png';
import featureImage4 from '@assets/images/features/howitworkscards4.png';
import additionalImage1 from '@assets/images/features/box.svg';
import additionalImage2 from '@assets/images/features/svg-path.svg';
import additionalImage3 from '@assets/images/features/Group.svg';

import Simone from '@assets/images/team/simone.jpg'
import Sam from '@assets/images/team/sam.png'
import Anna from '@assets/images/team/anna.jpg'
import Leo from '@assets/images/team/leo.jpg'

import eulogo from '@assets/images/supporters/eulogo.png'
import existlogo from '@assets/images/supporters/existlogo.png'
import imlogo from '@assets/images/supporters/imkereibedarflogo.png'
import ministrylogo from '@assets/images/supporters/bundesministeriumlogo.png'
import unilogo from '@assets/images/supporters/unigoelogo.png'


---

<DefaultLayout title="Aster Website" useTitleTemplate={false}>
  <Hero />

  <div class="w-full">
      <div class="flex flex-col items-center gap-8 md:items-start">
        <p class="text-center text-2xl md:text-left">
          SUPPORTED BY
        </p>
        <h3 class="text-center text-6xl md:text-left lg:text-8xl">Backed by organizations who believe in better beekeeping.</h3>
        <div class="flex flex-row flex-wrap lg:flex-nowrap items-center justify-center">
        <Supporterlogo
        profileImage={imlogo}
        name="Imkereibedarf logo"
        aria-hidden="true"
        />
        <Supporterlogo
        profileImage={unilogo}
        name="University of Goettingen logo"
        aria-hidden="true"
        />
        <Supporterlogo
        profileImage={existlogo}
        name="EXIST logo"
        aria-hidden="true"
        />
        <Supporterlogo
        profileImage={ministrylogo}
        name="Bundesministerium logo"
        aria-hidden="true"
        />
        <Supporterlogo
        profileImage={eulogo}
        name="European Union logo"
        aria-hidden="true"
        />
        </div>
      </div>
  </div>

  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24 lg:grid-cols-2">
      <div class="flex flex-col items-left gap-8 md:items-start">
        <p class="text-center text-2xl md:text-left">
          HOW IT WORKS
        </p>
        <h3 class="text-center text-6xl md:text-left lg:text-8xl">Personalized hive insights, right on your phone.</h3>

        <p class="text-center text-2xl md:text-left">
          Aster combines computer vision, remoste sensing, and data integration to give beekeepers real time insights into their hives.
        </p>
        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          
          
        </div>
      </div>
    </div>
  </div>

  <section class="mb-24">
    <div class="container grid gap-6 md:grid-cols-3">
      <Feature icon="lucide:layout-template" title="Capture" level="h2" imageloc={featureImage}>
        The beekeeper captures photos of their beehive with ther smartphone, hands free.
      </Feature>
      <Feature icon="lucide:scissors" title="Count" level="h2" imageloc={featureImage1}>
        Aster's computer vision model counts the bees with an accuracy rate of 96%.
      </Feature>
      <Feature icon="lucide:accessibility" title="Build accessibly" level="h2" imageloc={featureImage2}>
        Remote sensing data like weather trends, nearby crops, and blooms are integrated.
      </Feature>
      <Feature icon="lucide:accessibility" title="Analyze" level="h2" imageloc={featureImage3}>
        Considering all data available, Aster provides an analysis of the health of the hive.
      </Feature>
      <Feature icon="lucide:accessibility" title="Advise" level="h2" imageloc={featureImage4}>
        Aster shares reminders and recommendation on next steps for the beekeeper.
      </Feature>
    </div>
  </section>

  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24 lg:grid-cols-2">
      <div class="flex flex-col items-left gap-8 md:items-start">
        <p class="text-center text-2xl md:text-left">
          ADDITIONAL FEATURES
        </p>
      </div>
    </div>
  </div>

  <section class="mb-24">
    <div class="container grid gap-6 md:grid-cols-3">
      <Feature icon="lucide:layout-template" title="Inventory management" level="h2" imageloc={additionalImage1}>
        Tracking for all beekeeping materials, with reminders when you're running low.
      </Feature>
      <Feature icon="lucide:scissors" title="Community forum" level="h2" imageloc={additionalImage2}>
        A central hub for beekeepers from around teh wrold to share information, build community, and ask questions.
      </Feature>
      <Feature icon="lucide:accessibility" title="Partner marketplace" level="h2" imageloc={additionalImage3}>
        Through Aster's partner network, access special discounts on beekeeping materials.
      </Feature>
    </div>
  </section>

  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24 lg:grid-cols-2">
      <div class="flex flex-col items-left gap-8 md:items-start">
        <p class="text-center text-2xl md:text-left">
          WHAT'S THE BUZZ?
        </p>
        <h3 class="text-center text-4xl md:text-left lg:text-8xl">Join the Aster community</h3>

        <p class="text-center text-2xl md:text-left">
          Learn about what we're building, and participate in the process!
        </p>
        <!-- <div class="flex flex-col gap-2 min-[500px]:flex-row">
            

        </div> -->
      </div>
    </div>
    <CallToAction />

  </div>

  <section class="my-24 text-left" id="team">
    <div class="container">
      <h2 class="mb-16 text-6xl">Who we are</h2>
      <h3 class="mb-16 text-2xl">
        We are a team of beekeepers, scientists, and developers committed to making responsible beekeeping easier and more accessible.
      </h3>
      <div class="grid grid-cols-1 justify-stretch gap-12 md:grid-cols-4">
        <Team
          profileImage={Simone}
          name="Simone Massaro"
          experience="Simone is a forester, data scientist, and ecologist currently doing his PhD in satellite based forest monitoring. Simone brings his experience across ecology and software development to build a platform that can be used by beekeepers and researchers alike."
          education="Data science & ecological modelling"
        />
        <Team
          profileImage={Sam}
          name="Sam Herniman"
          experience="Specializing in remote sensing, machine learning, and applied ecology, Sam is charged with integrating diverse remote sensing sources. With over a decade of practical experience, Sam is motivated to build a platform that is based in responsible scientific practice. "
          education="Machine learning & remote sensing"
        />
        <Team
          profileImage={Anna}
          name="Anna Dodd"
          experience="Anna has worked across the fields of economic development, journalism, communications, and politics. For Aster, she brings her diverse experience to lead the company's communications, partnerships, and financials. She is also a beekeeping apprentice. "
          education="Business. partnerships & communications"
        />
        <Team
          profileImage={Leo}
          name="Leopold Dodd"
          experience="A certified beekeeper with 10 years of practical experience, Leopold provides beekeeping expertise and knowledge to inform the development of the app, leads app testing, and fosters Aster's beekeeper community. A native German speaker, he is the contact point for German relations."
          education="Beekeeping & field operations"
        />
      </div>
    </div>
  </section>


</DefaultLayout>
