---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import GradientBackground from '@components/GradientBackground.astro'
import LineSeparator from '@components/LineSeparator.astro'
import Team from '@components/Team.astro'
import Simone from '../assets/images/team/simone.jpg'
import Sam from '../assets/images/team/sam.png'
import Anna from '../assets/images/team/anna.png'
import Kelly from '../assets/images/team/kelly.jpg'
import CallToAction from '@components/CallToAction.astro'
---

<DefaultLayout title="Aster" showCallToAction={false}>
  <Hero />
  <section class="my-10" id="about">
    <GradientBackground title="About us" button={{ link: '/#team', linkText: 'Meet the team' }}>
      By beekeepers. For beekeepers
    </GradientBackground>
  </section>
  <section class="container my-24" id="services">
    <h2 class="mb-16 text-6xl">Join the Aster community</h2>
    <div class="grid-auto-rows-fr grid grid-cols-1 justify-items-center gap-16 md:grid-cols-2">
      <Feature icon="lucide:trees" title="Code for Forests" linkTo="forest">
        Precision forestry, forest inventories, and workflow digitalization of the forestry industry. We specialize in
        using remote sensing (LIDAR, spectral imagery, radar) to make forestry more efficient and sustainable.
      </Feature>
      <Feature icon="lucide:flower-2" title="Code for Biodiversity" linkTo="biodiversity">
        From the field to publication, we find ways of automating your biodiversity monitoring projects and workflows.
        We create platforms for data collection, analysis, and reporting to supercharge biodiversity initiatives.
      </Feature>
      <Feature icon="lucide:bar-chart" title="Code for Science" linkTo="science">
        Using open science best practices, we turn code for scientific research into reproducible and production-ready R
        and Python packages, websites, and APIs. This is programming that can make your research more impactful.
      </Feature>
      <Feature icon="lucide:workflow" title="Customized Solutions" linkTo="custom-solutions">
        Our team of data scientists, ecologists, and software engineers can develop apps, deep learning models, custom
        analyses, GIS platforms, or databases, making your data accessible with graphics, interactive dashboards, and
        more.
      </Feature>
    </div>
  </section>
  <LineSeparator height="4px" />

  <section class="my-24 text-left" id="team">
    <div class="container">
      <h2 class="mb-16 text-6xl">Who we are</h2>
      <div class="grid grid-cols-1 justify-stretch gap-12 md:grid-cols-4">
        <Team
          profileImage={Simone}
          name="Simone Massaro"
          experience="Data science, software engineering, natural science, forestry"
          education="MSc Forest and Ecosystem Sciences; BSc Forest and Natural Sciences"
        />
        <Team
          profileImage={Sam}
          name="Sam Herniman"
          experience="Remote sensing, ecology, machine learning, software development"
          education="MSc Forestry and Remote Sensing; BSc Applied Ecology"
        />
        <Team
          profileImage={Anna}
          name="Anna Dodd"
          experience="Communications, project management, research"
          education="MA History of Global Markets; IM Global Markets, Local Creativities; BA Political Science"
        />
        <Team
          profileImage={Kelly}
          name="Dr. Kelly Kapsar"
          experience="Ecology, biodiversity, software development, data science"
          education="Ph.D. Fisheries & Wildlife; B.A. Biology"
        />
      </div>
    </div>
  </section>
  <section class="container my-24" id="contact">
    <CallToAction />
  </section>
  <style>
    .avatar {
      border: 1px solid var(--border-color-subtle);
      border-radius: var(--radius-md);
      padding: var(--space-s);
    }
  </style>
</DefaultLayout>
