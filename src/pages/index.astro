---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import AdditionalFeature from '@components/AdditionalFeature.astro'
import Team from '@components/Team.astro'
import CallToAction from '@components/CallToAction.astro'
import Supporterlogo from '@components/SupporterLogo.astro'
import SectionSeparator from '@components/SectionSeparator.astro'

import featureImage from '@assets/images/features/howitworkscards.png'
import featureImage1 from '@assets/images/features/howitworkscards1.png'
import featureImage2 from '@assets/images/features/howitworkscards2.png'
import featureImage3 from '@assets/images/features/howitworkscards3.png'
import featureImage4 from '@assets/images/features/howitworkscards4.png'

import {ShoppingCart, Box, MessageCircle} from "@lucide/astro"

import Simone from '@assets/images/team/simone.jpg'
import Sam from '@assets/images/team/sam.png'
import Anna from '@assets/images/team/anna.jpg'
import Leo from '@assets/images/team/leo.jpg'

import eulogo from '@assets/images/supporters/eulogo.png'
import existlogo from '@assets/images/supporters/existlogo.png'
import imlogo from '@assets/images/supporters/imkereibedarflogo.png'
import ministrylogo from '@assets/images/supporters/bundesministeriumlogo.png'
import unilogo from '@assets/images/supporters/unigoelogo.png'
import Subscribe from '@components/Subscribe.astro'
---

<DefaultLayout title="Aster Website" useTitleTemplate={false}>
  <Hero />

  <!-- <div class="w-full"> -->
  <div style="padding-bottom: 60px;" class="container">
    <div class="flex flex-col justify-between gap-8">
      <!-- <p class="text-center text-2xl">
          SUPPORTED BY
        </p> -->
      <h3 class="text-center text-6xl lg:text-4xl">Backed by organizations who believe in better beekeeping.</h3>
      <div class="flex flex-row flex-wrap items-center justify-center lg:flex-nowrap">
        <Supporterlogo profileImage={imlogo} name="Imkereibedarf logo" aria-hidden="true" />
        <Supporterlogo profileImage={unilogo} name="University of Goettingen logo" aria-hidden="true" />
        <Supporterlogo profileImage={existlogo} name="EXIST logo" aria-hidden="true" />
        <!-- <Supporterlogo
        profileImage={ministrylogo}
        name="Bundesministerium logo"
        aria-hidden="true"
        />
        <Supporterlogo
        profileImage={eulogo}
        name="European Union logo"
        aria-hidden="true"
        /> -->
      </div>
    </div>
  </div>

  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24">
      <div class="flex flex-col items-center gap-8">
        <!-- <p class="text-center text-2xl">
          HOW IT WORKS
        </p> -->
        <h3 class="text-center text-6xl lg:text-4xl">Personalized hive insights, right on your phone.</h3>
        <p class="text-left text-2xl">
          Aster combines computer vision, remote sensing, and data integration to give beekeepers real time insights
          into their hives.
        </p>
      </div>
    </div>
  </div>

  <section class="mb-24">
    <div class="container grid gap-6 md:grid-cols-3">
      <!-- <div class="flex flex-row flex-wrap flex-shrink md:flex-nowrap items-center justify-center"> -->
      <Feature
        icon="lucide:layout-template"
        title="Capture"
        number="1"
        text="The beekeeper captures photos of their beehive with ther smartphone, hands free."
        level="h2"
        imageloc={featureImage}
      />
      <Feature
        icon="lucide:scissors"
        title="Count"
        number="2"
        text="Aster's computer vision model counts the bees with an accuracy rate of 96%."
        level="h2"
        imageloc={featureImage1}
      />
      <Feature
        icon="lucide:accessibility"
        title="Build"
        number="3"
        text="Remote sensing data like weather trends, nearby crops, and blooms are integrated."
        level="h2"
        imageloc={featureImage2}
      />
      <Feature
        icon="lucide:accessibility"
        title="Analyze"
        number="4"
        text="Considering all data available, Aster provides an analysis of the health of the hive."
        level="h2"
        imageloc={featureImage3}
      />
      <Feature
        icon="lucide:accessibility"
        title="Advise"
        number="5"
        text="Aster shares reminders and recommendation on next steps for the beekeeper."
        level="h2"
        imageloc={featureImage4}
      />
      <Feature
        icon="lucide:accessibility"
        title="The next"
        number="5"
        text="Aster shares reminders and recommendation on next steps for the beekeeper."
        level="h2"
        imageloc={featureImage4}
      />
    </div>
  </section>


  <SectionSeparator title="Additional features" />
  <section class="mb-24">
    <div class="container grid gap-6 md:grid-cols-3">
      <AdditionalFeature title="Inventory management" Icon={Box}>
        Tracking for all beekeeping materials, with reminders when you're running low.
      </AdditionalFeature>
      <AdditionalFeature title="Community forum" Icon={MessageCircle}>
        A central hub for beekeepers to share information, build community, and ask questions.
      </AdditionalFeature>
      <AdditionalFeature title="Partner marketplace" Icon={ShoppingCart}>
        Through Aster's partner network, access special discounts on beekeeping materials.
      </AdditionalFeature>
    </div>
  </section>

  <div class="container">
    <!-- <div class="grid grid-cols-1 gap-24 lg:grid-cols-2"> -->
    <!-- <div class="flex flex-col items-left gap-8 md:items-start">
        <p class="text-center text-2xl md:text-left">
          WHAT'S THE BUZZ?
        </p>
        <h3 class="text-center text-4xl md:text-left lg:text-4xl">Join the Aster community</h3>

        <p class="text-center text-2xl md:text-left">
          Learn about what we're building, and participate in the process!
        </p> -->
    <!-- </div> -->

    <CallToAction />

    <!-- </div> -->
  </div>

  <section class="my-24 text-left" id="team">
    <div class="container">
      <h2 class="mb-16 text-6xl">Who we are</h2>
      <h3 class="mb-16 text-2xl">
        We are a team of beekeepers, scientists, and developers committed to making responsible beekeeping easier and
        more accessible.
      </h3>
      <div class="grid grid-cols-1 justify-stretch gap-6 md:grid-cols-2">
        <Team
          profileImage={Simone}
          title="Simone Massaro"
          experience="Simone is a forester, data scientist, and ecologist currently doing his PhD in satellite based forest monitoring. Simone brings his experience across ecology and software development to build a platform that can be used by beekeepers and researchers alike."
          education="Data science & ecological modelling"
        />
        <Team
          profileImage={Sam}
          title="Sam Herniman"
          experience="Specializing in remote sensing, machine learning, and applied ecology, Sam is charged with integrating diverse remote sensing sources. With over a decade of practical experience, Sam is motivated to build a platform that is based in responsible scientific practice."
          education="Machine learning & remote sensing"
        />
        <Team
          profileImage={Anna}
          title="Anna Dodd"
          experience="Anna has worked across the fields of economic development, journalism, communications, and politics. For Aster, she brings her diverse experience to lead the company's communications, partnerships, and financials. She is also a beekeeping apprentice."
          education="Business. partnerships & communications"
        />
        <Team
          profileImage={Leo}
          title="Leopold Dodd"
          experience="A certified beekeeper with 10 years of practical experience, Leopold provides beekeeping expertise and knowledge to inform the development of the app, leads app testing, and fosters Aster's beekeeper community. A native German speaker, he is the contact point for German relations."
          education="Beekeeping & field operations"
        />
      </div>
    </div>
  </section>
</DefaultLayout>
